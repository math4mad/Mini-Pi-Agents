# 复制为 .env 后填写；程序启动时会读取当前工作目录下的 .env。
# 必填：API Key 二选一
OPENROUTER_API_KEY=
# OPENAI_API_KEY=

# 必填：模型名；兼容 openrouter/ 前缀写法
MODEL_NAME=nvidia/nemotron-3-ultra-550b-a55b:free

# 可选：API 地址，默认 https://openrouter.ai/api/v1
# OPENAI_BASE_URL=https://openrouter.ai/api/v1

# 可选：Redux DevTools 端口，默认 8000
# REDUX_DEVTOOLS_PORT=8000

# 可选：sandbox 配置（默认 docker，fail closed）
# SANDBOX_MODE=docker
# SANDBOX_IMAGE=mini-pi-sandbox:node
