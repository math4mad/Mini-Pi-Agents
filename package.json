{
	"name": "mini-pi-agents",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"description": "Minimal Pi-style coding agent with Redux/Redux-Saga state management",
	"engines": {
		"node": ">=22.19.0"
	},
	"scripts": {
		"start": "node --env-file=.env src/index.ts",
		"dev": "node --env-file=.env src/index.ts",
		"tui": "node --env-file=.env src/index.ts --tui",
		"devtools": "redux-devtools --port 8000",
		"poc": "node poc/run.ts",
		"test": "node --test",
		"typecheck": "tsc --noEmit"
	},
	"devDependencies": {
		"@redux-devtools/cli": "^4.0.3",
		"@types/node": "^24.10.1",
		"@types/redux-logger": "^3.0.13",
		"graphql-yoga": "^6.0.1",
		"typescript": "^5.9.3"
	},
	"dependencies": {
		"@earendil-works/pi-ai": "^1.5.2",
		"@earendil-works/pi-coding-agent": "^1.5.2",
		"@earendil-works/pi-tui": "^1.5.2",
		"@redux-devtools/remote": "^1.0.2",
		"graphql": "^16.15.0",
		"graphql-sse": "^2.6.3",
		"redux": "^5.0.1",
		"redux-logger": "^3.0.6",
		"redux-saga": "^1.5.1"
	},
	"allowScripts": {
		"sqlite3@5.1.7": true
	}
}
